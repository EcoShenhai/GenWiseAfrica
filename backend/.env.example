# GenWise Africa backend — copy to .env (never commit .env).
# On the droplet this file is generated by scripts/genwise-setup.sh.
# Quote any value that contains # or spaces.
NODE_ENV=production
PORT=4022
BIND_HOST=127.0.0.1
APP_NAME="GenWise Africa"
APP_DOMAIN=genwiseafrica.org
APP_BASE_URL=https://genwiseafrica.org
FRONTEND_URL=https://genwiseafrica.org
CORS_ORIGINS=https://genwiseafrica.org,https://www.genwiseafrica.org

DB_HOST=<managed-cluster>.db.ondigitalocean.com
DB_PORT=25060
DB_NAME=genwise_db
DB_USER=genwise_user
DB_PASSWORD=
DB_SSL=true
DB_POOL_MAX=2

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_MFA_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
MFA_TOKEN_EXPIRES_IN=10m
BCRYPT_ROUNDS=12
AUTH_CODE_LENGTH=6
AUTH_CODE_TTL_MIN=10
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_RESEND_COOLDOWN_SEC=60
AUTH_CODE_PEPPER=

SMTP_HOST=mail-eu.smtp2go.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=GenWiseAfrica
SMTP_PASSWORD=
SMTP_FROM_NAME="GenWise Africa"
SMTP_FROM_EMAIL=noreply@genwiseafrica.org

SUPER_ADMIN_1_EMAIL=pskipchumba@gmail.com
SUPER_ADMIN_1_NAME="Peter Kipchumba"
SUPER_ADMIN_1_PASSWORD=
SUPER_ADMIN_2_EMAIL=christineariga3@gmail.com
SUPER_ADMIN_2_NAME="Christine Ariga"
SUPER_ADMIN_2_PASSWORD=

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1500
AI_DAILY_TOKEN_BUDGET_PER_TENANT=200000

SFU_PROVIDER=livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM_PREFIX=genwise-
TURN_URL=turn:turn.eshcloud.com:3478
TURN_SECRET=
JITSI_DOMAIN=meet.jit.si

MPESA_RECEIVER=254702122874
MPESA_DISPLAY="0702 122 874"

STORAGE_DIR=/srv/apps/genwise/backend/uploads
MAX_UPLOAD_MB=200
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
